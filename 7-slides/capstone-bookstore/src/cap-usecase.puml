@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
left to right direction

actor "Покупатель" as C
actor "Администратор" as A
actor "Курьер" as Cou
actor "Stripe" as S

rectangle "BookNook" {
  usecase "Искать книги" as UC1
  usecase "Просмотреть книгу" as UC2
  usecase "Добавить в корзину" as UC3
  usecase "Оформить заказ" as UC4
  usecase "Оплатить" as UC5
  usecase "Применить промокод" as UC6
  usecase "Оставить отзыв" as UC7
  usecase "Управлять каталогом" as UC8
  usecase "Подтвердить доставку" as UC9
}

C -- UC1
C -- UC2
C -- UC3
C -- UC4
C -- UC7
A -- UC8
Cou -- UC9
UC4 ..> UC5 : <<include>>
UC4 <.. UC6 : <<extend>>
UC5 -- S
@enduml
