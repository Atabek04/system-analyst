    {
      "type": "text",
      "id": "f8_not_d",
      "x": 15265,
      "y": 605,
      "width": 610,
      "height": 70,
      "text": "POST /orders дважды = ДВА заказа.\nВот почему двойное нажатие «Оплатить»\nопасно именно с POST.",
      "originalText": "POST /orders дважды = ДВА заказа.\nВот почему двойное нажатие «Оплатить»\nопасно именно с POST.",
      "fontSize": 21,
